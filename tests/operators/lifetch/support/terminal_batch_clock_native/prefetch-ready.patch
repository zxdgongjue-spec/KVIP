+// Diagnostic samples use only Q2's window-prefetch CQ. The final-GET CQ is
+// supplied separately so an accidental alias is visible to the reader.
+struct ReadOnlyPrefetchCq {
+    ::CqAccess access;
+    uint32_t lastWord{};
+    __aicore__ inline uint32_t Read(uint32_t slot) {
+        lastWord=access.Read(slot);
+        return lastWord;
+    }
+};
+__aicore__ inline void ObservePrefetch(__gm__ Context* ctx, uint32_t row,
+    const __gm__ KvafExecuteBatchGetKernelArgs* finalArgs, __gm__ uint64_t* dest) {
+    dest[0]=GetSystemCycle();
+    auto a=reinterpret_cast<__gm__ KvafExecuteBatchGetKernelArgs*>(ctx->args)+2*row;
+    auto e=reinterpret_cast<__gm__ KvafBatchGetDirectUrmaEntity*>(a->channel_entity);
+    auto f=reinterpret_cast<__gm__ KvafBatchGetDirectUrmaEntity*>(finalArgs->channel_entity);
+    auto queue=reinterpret_cast<__gm__ KvafBatchGetQueueState*>(a->queue_state);
+    auto state=reinterpret_cast<__gm__ Row*>(ctx->rows)+row;
+    kvaf_device::CleanCacheLines(reinterpret_cast<__gm__ uint8_t*>(&state->pending),sizeof(state->pending));
+    kvaf_device::CleanCacheLines(reinterpret_cast<__gm__ uint8_t*>(queue),sizeof(*queue));
+    const uint64_t cursor=queue->cq_consumer_index;
+    const uint32_t pending=state->pending;
+    dest[2]=cursor;dest[3]=pending;
+    uint32_t status=4; // invalid lease, range or visible error
+    if(e->cq_va!=f->cq_va && a->queue_state!=finalArgs->queue_state &&
+       e->cq_depth>1 && pending<e->cq_depth && pending<=5 && cursor<=UINT64_MAX-pending) {
+        ReadOnlyPrefetchCq p{{reinterpret_cast<__gm__ uint8_t*>(e->cq_va),e->cqe_size,
+            reinterpret_cast<__gm__ uint32_t*>(e->cq_db_va),queue}};
+        // The verified observer handles up to four positions. A five-window
+        // policy can leave a fifth CQE. Inspect it only after a successful prefix.
+        const uint32_t prefix=pending>4?4:pending;
+        bool done=::joint_tail::PrefetchVisible(p,cursor,e->cq_depth,prefix);
+        if(done && !(p.lastWord>>16) && pending>prefix)
+            done=::joint_tail::PrefetchVisible(p,cursor+prefix,e->cq_depth,pending-prefix);
+        status=!pending?3:(done?(p.lastWord>>16?4:2):1);
+    }
+    dest[4]=status;dest[1]=GetSystemCycle();
+}
