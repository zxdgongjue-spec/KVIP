+// Diagnostic layout: 16 header words, 128 doorbells, 128 completion observations.
+__aicore__ inline void TraceDoorbell(__gm__ uint64_t *trace, uint32_t i, uint32_t group) {
+  if (!trace) return;
+  if (i >= 128U) { trace[2] = 1U; return; }
+  trace[16U + 2U*i] = AscendC::GetSystemCycle();
+  trace[17U + 2U*i] = group;
+  trace[0] = i+1;
+}
