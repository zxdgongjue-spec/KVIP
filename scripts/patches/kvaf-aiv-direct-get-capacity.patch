diff --git a/runtime/include/peer_execution_resources.h b/runtime/include/peer_execution_resources.h
--- a/runtime/include/peer_execution_resources.h
+++ b/runtime/include/peer_execution_resources.h
@@ -58,4 +58,10 @@
   }
   Status ValidateCapacity(std::uint32_t count) const {
+    // Direct AIV Get consumes the caller's descriptor tensors. Its queue
+    // depth and in-flight budget are independent of descriptor capacity.
+    if (!config_.put && config_.executor == Executor::Aiv &&
+        config_.algorithm == GetAlgorithm::Direct) {
+      return Status::OK();
+    }
     return count <= capacity_ ? Status::OK()
                              : Status::InvalidArgument("request exceeds execution resource capacity");
