+  std::uint64_t region_bytes{0};
+  std::uint64_t slot_bytes{0};
+  std::uint64_t output_address{0};
+  std::uint64_t output_bytes{0};
+  std::uint32_t token_bytes{0};
+  std::uint32_t tokens_per_block{0};
+};
+
+}  // namespace kvaf
