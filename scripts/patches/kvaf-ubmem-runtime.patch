diff --git a/tests/python/test_ubmem_runtime.py b/tests/python/test_ubmem_runtime.py
new file mode 100755
index 0000000000000000000000000000000000000000..8bb6b0a498fda60c4d8986d015dc3959332bca9a
--- /dev/null
+++ b/tests/python/test_ubmem_runtime.py
@@ -0,0 +1,163 @@
+#!/usr/bin/env python3
+"""Small real-device UBmem Put/Get/free and Get-graph check, with no model or CPU service."""
+
+from __future__ import annotations
+
+import argparse
+from array import array
+from pathlib import Path
+
+
+def check_width(kvaf, torch, build: Path, device_id: int, token_bytes: int) -> None:
+    tokens_per_block = 128
+    block_bytes = tokens_per_block * token_bytes
+    slot_size = (block_bytes + 4095) // 4096 * 4096
+    device = f"npu:{device_id}"
+    get_kernel = build / "bin/kvaf_ubmem_batch_get.o"
+    put_kernel = build / "bin/kvaf_ubmem_batch_put.o"
+    for kernel in (get_kernel, put_kernel):
+        if not kernel.is_file():
+            raise FileNotFoundError(kernel)
+    runtime = kvaf.NpuRuntime(
+        str(get_kernel),
+        token_bytes,
+        tokens_per_block,
+        device_id=device_id,
+        npu_core_count=2,
+        batch_put_kernel_object_path=str(put_kernel),
+        transport="ubmem",
+    )
+    assert runtime.transport == "ubmem"
+    table = None
+    graph = None
+    keys = [0, 1]
+    source_cpu = (torch.arange(2 * block_bytes, dtype=torch.int64) % 251).to(
+        torch.uint8
+    )
+    packed_prefix = 37
+    source = torch.cat(
+        [torch.full((packed_prefix,), 173, dtype=torch.uint8), source_cpu]
+    ).to(device)
+    put_offsets = [packed_prefix, packed_prefix + block_bytes]
+    indices = torch.tensor([1, 0], dtype=torch.int32, device=device)
+    offsets = torch.tensor(
+        [127 * token_bytes, token_bytes], dtype=torch.int32, device=device
+    )
+    count = torch.tensor([2], dtype=torch.int32, device=device)
+    destinations = torch.tensor([0, 1], dtype=torch.int32, device=device)
+    output = torch.empty((2, token_bytes), dtype=torch.uint8, device=device)
+    stream = torch.npu.Stream(device=device_id)
+    torch.npu.synchronize()
+
+    def expected(rows):
+        blocks = source_cpu.reshape(2, tokens_per_block, token_bytes)
+        return torch.stack([blocks[1, rows[0]], blocks[0, rows[1]]])
+
+    try:
+        # Deliberately no link_to(): this Runtime owns the local Host DDR arena.
+        runtime.initialize(4 * slot_size, slot_size)
+        runtime.batch_put(keys, source, put_offsets, [block_bytes, block_bytes])
+        table = runtime.prepare_access_table(keys)
+        device_table = runtime.access_table_view(table, device="npu")
+        runtime.batch_get(
+            device_table, indices, offsets, count, destinations, output, stream=stream
+        )
+        stream.synchronize()
+        assert torch.equal(output.cpu(), expected([127, 1])), (
+            "UBmem Put/Get byte mismatch"
+        )
+
+        try:
+            runtime.batch_free(keys)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("batch_free accepted keys pinned by an access table")
+
+        # Warmed Get above allocates its workspace before capture. Only fixed
+        # device descriptors are consumed by the captured launch.
+        graph = kvaf.AclGraph()
+        graph.capture_begin(stream)
+        runtime.batch_get(
+            device_table, indices, offsets, count, destinations, output, stream=stream
+        )
+        graph.capture_end()
+        for rows in ([0, 127], [1, 126], [126, 0]):
+            values = array("i", [row * token_bytes for row in rows])
+            assert values.itemsize == 4
+            graph.copy_host_to_device_async(
+                offsets.data_ptr(),
+                offsets.numel() * offsets.element_size(),
+                values,
+                stream,
+            )
+            graph.replay(stream)
+            graph.synchronize(stream)
+            assert torch.equal(output.cpu(), expected(rows)), (
+                "UBmem Get graph byte mismatch"
+            )
+        graph.reset()
+        graph = None
+
+        runtime.release_access_table(table)
+        table = None
+        runtime.batch_free(keys)
+        # Reuse freed keys with different bytes; stale mapping/data cannot pass.
+        source_cpu = ((source_cpu.to(torch.int64) + 31) % 251).to(torch.uint8)
+        source[packed_prefix:].copy_(source_cpu)
+        torch.npu.synchronize()
+        runtime.batch_put(keys, source, put_offsets, [block_bytes, block_bytes])
+        table = runtime.prepare_access_table(keys)
+        device_table = runtime.access_table_view(table, device="npu")
+        runtime.batch_get(
+            device_table, indices, offsets, count, destinations, output, stream=stream
+        )
+        stream.synchronize()
+        assert torch.equal(output.cpu(), expected([126, 0])), (
+            "UBmem key reuse byte mismatch"
+        )
+        runtime.release_access_table(table)
+        table = None
+        runtime.batch_free(keys)
+    finally:
+        if graph is not None:
+            if graph.capturing:
+                graph.capture_end()
+            if graph.ready:
+                graph.synchronize(stream)
+            graph.reset()
+        stream.synchronize()
+        if table is not None:
+            runtime.release_access_table(table)
+        if runtime.initialized:
+            runtime.shutdown()
+    print(
+        f"UBMEM_RUNTIME_PASS device={device_id} token_bytes={token_bytes} put=get=free=reuse=graph"
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--build-dir", type=Path, required=True)
+    parser.add_argument("--device", type=int, default=0)
+    args = parser.parse_args()
+    import kvaf
+    import torch
+    import torch_npu  # noqa: F401
+
+    build = args.build_dir.resolve()
+    if not Path(kvaf.__file__).resolve().is_relative_to(build / "python/kvaf"):
+        raise RuntimeError(
+            f"Imported {kvaf.__file__}; set PYTHONPATH={build / 'python'}"
+        )
+    if not torch.npu.is_available():
+        raise RuntimeError(
+            "UBmem smoke test requires an available NPU; it cannot be skipped"
+        )
+    torch.npu.set_device(args.device)
+    for token_bytes in (656, 2624):
+        check_width(kvaf, torch, build, args.device, token_bytes)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/runtime_completion_test.cc b/tests/runtime_completion_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ae756c1b44326f5add92d18c5e97aef711f71393
--- /dev/null
+++ b/tests/runtime_completion_test.cc
@@ -0,0 +1,102 @@
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+#include "meta_manager.h"
+#include "runtime.h"
+
+namespace {
+void Require(bool condition, const char* message) {
+  if (!condition) throw std::runtime_error(message);
+}
+
+class Allocator final : public kvaf::DdrMemoryAllocator {
+ public:
+  kvaf::Status Allocate(const kvaf::RuntimeInitRequest& request,
+                       kvaf::RemoteRegionDesc* region) override {
+    storage.resize(request.ddr_bytes);
+    *region = {reinterpret_cast<kvaf::Address>(storage.data()), request.ddr_bytes,
+               request.slot_size, kvaf::DeviceKind::kCpu};
+    return kvaf::Status::OK();
+  }
+  kvaf::Status Release(const kvaf::RemoteRegionDesc&) override {
+    ++releases;
+    if (fail_release) return kvaf::Status::Internal("unmap failed");
+    return kvaf::Status::OK();
+  }
+  bool fail_release{false};
+  int releases{0};
+  std::vector<std::uint8_t> storage;
+};
+
+class Operator final : public kvaf::AccessOperator {
+ public:
+  kvaf::Status Initialize(const kvaf::RemoteRegionDesc&) override { return kvaf::Status::OK(); }
+  kvaf::Status Shutdown() override { ++shutdowns; return kvaf::Status::OK(); }
+  kvaf::Status ExecuteBatchGet(const kvaf::BatchGetExecRequest&) override { return kvaf::Status::OK(); }
+  kvaf::Status ExecuteBatchPut(const kvaf::BatchPutExecRequest&) override {
+    ++writes;
+    return result;
+  }
+  kvaf::Status result;
+  int writes{0};
+  int shutdowns{0};
+};
+
+void TestPutCompletion(bool unknown) {
+  Allocator allocator;
+  Operator op;
+  auto metadata = kvaf::CreateInMemoryMetaManager();
+  kvaf::RuntimeCore core(*metadata, op, allocator);
+  Require(core.Initialize({4096, 256, kvaf::DeviceKind::kCpu}).ok(), "initialize");
+  std::uint8_t input[8]{};
+  const kvaf::BatchPutRequest put{{0}, {input, sizeof(input), kvaf::DeviceKind::kCpu}, {0}, {8}};
+  op.result = unknown ? kvaf::Status::CompletionUnknown("submitted, synchronization failed")
+                      : kvaf::Status::InvalidArgument("not submitted");
+  Require(!core.BatchPut(put).ok(), "failed Put must not commit");
+  if (unknown) {
+    kvaf::PutContext context;
+    kvaf::PutAccessDesc destinations;
+    Require(!metadata->PreparePut({0}, {8}, &context, &destinations).ok(), "unknown Put must retain slot");
+    Require(core.BatchPut(put).code() == kvaf::StatusCode::kCompletionUnknown, "reject subsequent Put");
+    Require(core.BatchFree({{0}}).code() == kvaf::StatusCode::kCompletionUnknown, "reject free");
+    kvaf::AccessTableHandle table;
+    Require(core.PrepareAccessTable({{0}}, &table).code() == kvaf::StatusCode::kCompletionUnknown,
+            "reject reads from quarantined Runtime");
+    Require(core.Shutdown().code() == kvaf::StatusCode::kCompletionUnknown, "retain DDR on shutdown");
+    Require(allocator.releases == 0 && op.writes == 1, "no release or new device work");
+  } else {
+    op.result = kvaf::Status::OK();
+    Require(core.BatchPut(put).ok(), "unsubmitted failure must release its reservation");
+    kvaf::AccessTableHandle table;
+    Require(core.PrepareAccessTable({{0}}, &table).ok(), "read committed key");
+    kvaf::AccessTableView view;
+    Require(core.GetAccessTableView(table, &view).ok() && view.size == 1 && view.valid[0], "visible only after completion");
+    Require(core.ReleaseAccessTable(table).ok(), "release read lock");
+    Require(core.BatchFree({{0}}).ok(), "free committed key");
+    Require(core.Shutdown().ok() && allocator.releases == 1, "normal teardown");
+  }
+}
+
+void TestPartialTeardown() {
+  Allocator allocator;
+  Operator op;
+  auto metadata = kvaf::CreateInMemoryMetaManager();
+  kvaf::RuntimeCore core(*metadata, op, allocator);
+  Require(core.Initialize({4096, 256, kvaf::DeviceKind::kCpu}).ok(), "initialize cleanup test");
+  allocator.fail_release = true;
+  Require(!core.Shutdown().ok() && core.initialized(), "retain incomplete cleanup state");
+  Require(core.BatchFree({{0}}).code() == kvaf::StatusCode::kInvalidState, "reject work during cleanup");
+  allocator.fail_release = false;
+  Require(core.Shutdown().ok(), "retry arena release");
+  Require(op.shutdowns == 1 && allocator.releases == 2, "retry only unfinished cleanup");
+}
+}  // namespace
+
+int main() {
+  TestPutCompletion(false);
+  TestPutCompletion(true);
+  TestPartialTeardown();
+  std::cout << "PASS: Runtime Put completion and slot lifetime\n";
+}
diff --git a/tests/ubmem_host_arena_stubs/acl/acl.h b/tests/ubmem_host_arena_stubs/acl/acl.h
new file mode 100644
index 0000000000000000000000000000000000000000..b7b287603a38132a79e4d33984c7a1bc6305fae4
--- /dev/null
+++ b/tests/ubmem_host_arena_stubs/acl/acl.h
@@ -0,0 +1,49 @@
+#pragma once
+
+// Private ABI surface for the portable allocator lifecycle test. Production
+// targets must include the CANN SDK headers instead of this directory.
+#include <cstddef>
+#include <cstdint>
+
+using aclError = int;
+using aclrtDrvMemHandle = void*;
+constexpr aclError ACL_SUCCESS = 0;
+enum aclrtMemHandleType { ACL_MEM_HANDLE_TYPE_NONE };
+enum aclrtMemAllocationType { ACL_MEM_ALLOCATION_TYPE_PINNED };
+enum aclrtMemAttr { ACL_DDR_MEM_P2P_HUGE };
+enum aclrtMemLocationType {
+  ACL_MEM_LOCATION_TYPE_HOST_NUMA,
+  ACL_MEM_LOCATION_TYPE_DEVICE
+};
+enum aclrtMemGranularityOptions { ACL_RT_MEM_ALLOC_GRANULARITY_MINIMUM };
+enum aclrtMemAccessFlags { ACL_RT_MEM_ACCESS_FLAGS_READWRITE };
+struct aclrtMemLocation {
+  aclrtMemLocationType type;
+  std::uint32_t id;
+};
+struct aclrtPhysicalMemProp {
+  aclrtMemHandleType handleType;
+  aclrtMemAllocationType allocationType;
+  aclrtMemAttr memAttr;
+  aclrtMemLocation location;
+};
+struct aclrtMemAccessDesc {
+  aclrtMemLocation location;
+  aclrtMemAccessFlags flags;
+};
+
+extern "C" {
+aclError aclrtGetDevice(std::int32_t*);
+aclError aclsysGetVersionNum(char*, std::int32_t*);
+aclError aclrtMemGetAllocationGranularity(aclrtPhysicalMemProp*,
+    aclrtMemGranularityOptions, std::size_t*);
+aclError aclrtMallocPhysical(aclrtDrvMemHandle*, std::size_t,
+    const aclrtPhysicalMemProp*, std::uint64_t);
+aclError aclrtReserveMemAddress(void**, std::size_t, std::size_t, void*, std::uint64_t);
+aclError aclrtMapMem(void*, std::size_t, std::size_t, aclrtDrvMemHandle, std::uint64_t);
+aclError aclrtMemSetAccess(void*, std::size_t, aclrtMemAccessDesc*, std::size_t);
+aclError aclrtSynchronizeDevice();
+aclError aclrtUnmapMem(void*);
+aclError aclrtFreePhysical(aclrtDrvMemHandle);
+aclError aclrtReleaseMemAddress(void*);
+}
diff --git a/tests/ubmem_host_arena_stubs/acl/acl_rt.h b/tests/ubmem_host_arena_stubs/acl/acl_rt.h
