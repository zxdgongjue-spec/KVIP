+++ b/access_operator/providers/urma_aiv/access_operator.cc
@@ -141,6 +141,19 @@ Status DefaultAccessOperator::PrepareGetGraph(const GetGraphOptions& options) {
   auto status = UrmaAivGetOperator::PrepareGraph(options, resources_->GetView(), call);
   return status.ok() ? resources_->PrepareGraph(options, call) : status;
 }
+Status DefaultAccessOperator::GetPreparedGraphUrmaResources(std::uint64_t* out) {
+  const auto& call = resources_->invocation();
+  const auto view = resources_->GetView();
+  if (!out || !call.graph_buffer || !view.channel_entity ||
+      !view.workspace.status || !view.workspace.queue_state)
+    return Status::InvalidState("URMA Get graph resources are unavailable");
+  out[0] = view.channel_entity;
+  out[1] = reinterpret_cast<std::uintptr_t>(view.workspace.status);
+  out[2] = reinterpret_cast<std::uintptr_t>(view.workspace.queue_state);
+  out[3] = view.options.npu_core_count;
+  out[4] = view.options.jettys_per_core;
+  return Status::OK();
+}
 Status DefaultAccessOperator::FinishGetGraph(void* stream, bool discard) {
   return UrmaAivGetOperator::FinishGraph(stream, discard, resources_->GetView(), resources_->invocation());
 }
