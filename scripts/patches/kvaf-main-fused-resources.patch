+Status ExecutionDispatcher::GetGraphUrmaResources(std::uint64_t id, std::uint64_t* out) {
+  std::shared_lock<std::shared_mutex> life(lifecycle_);
+  std::lock_guard<std::mutex> lock(get_mutex_);
+  GetGraphNode* node = nullptr;
+  auto status = FindGraphNode(nullptr, id, &node);
+  if (!status.ok()) return status;
+  if (!node || node->ending)
+    return Status::InvalidArgument("a live Get graph lease is required");
+  return WithGraphNode(*node, [&](GetResourceView view) {
+    return view.operation()->GetPreparedGraphUrmaResources(out);
+  });
+}
+Status ExecutionDispatcher::GetGraphMappedBase(std::uint64_t id, std::uint64_t* base) {
+  std::shared_lock<std::shared_mutex> life(lifecycle_);
+  std::lock_guard<std::mutex> lock(get_mutex_);
+  GetGraphNode* node = nullptr;
+  auto status = FindGraphNode(nullptr, id, &node);
+  if (!status.ok()) return status;
+  if (!node) return Status::InvalidArgument("a live Get graph lease is required");
+  return WithGraphNode(*node, [&](GetResourceView view) {
+    return view.operation()->GetPreparedGraphMappedBase(base);
+  });
+}
