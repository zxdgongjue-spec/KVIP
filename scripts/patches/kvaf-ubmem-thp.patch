+  Require(region.base == reinterpret_cast<std::uintptr_t>(HostDeviceAddress()) &&
+              mapping.host_base == reinterpret_cast<std::uintptr_t>(Address()) &&
+              mapping.device_base == region.base && mapping.host_base != mapping.device_base &&
