+Status AccessOperator::GetPreparedGraphMappedBase(std::uint64_t* base) {
+  std::lock_guard<std::mutex> lock(resources_->mutex);
+  if (!base) return Status::InvalidArgument("null mapped base output");
+  if (!resources_->invocation->graph_active || !resources_->mapping)
+    return Status::InvalidState("UBmem graph mapping is not prepared");
+  *base = resources_->mapping->address();
+  return Status::OK();
+}
