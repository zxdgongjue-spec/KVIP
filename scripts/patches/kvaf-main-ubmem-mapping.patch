+  std::lock_guard<std::mutex> lock(get_mutex_);
+  GetGraphNode* node = nullptr;
+  auto status = FindGraphNode(nullptr, id, &node);
+  if (!status.ok()) return status;
+  if (!node) return Status::InvalidArgument("a live Get graph lease is required");
