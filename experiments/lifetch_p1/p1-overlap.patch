new file mode 100644
index 00000000..82038eab
--- /dev/null
+++ b/csrc/operators/common/lifetch/p1_overlap_schedule.h
@@ -0,0 +1,65 @@
+#pragma once
+#include <cstring>
+#include <type_traits>
+#include "score_window_plan.h"
+
+namespace kvip_score_t2 {
+// P1 uses one MIX block per request. Each score block uses two AIV lanes
+// in the current kernel's execution layout. Paired TopK can use fewer
+// than 2B lanes, with each lane looping over its remaining query pairs.
+inline uint32_t P1ServiceBlocks(uint32_t batch, uint32_t availableAivs) {
+    if (!batch || batch > 16) return 0;
+    const uint32_t scoreAivs = 2 * batch;
+    if (availableAivs <= scoreAivs) return 0;
+    const uint32_t spare = availableAivs - scoreAivs;
+    return spare < scoreAivs ? spare : scoreAivs;
+}
+
+// Prevalidate every launch and event before either stream is mutated.
+// When streams alias, use the same kernels with serialized dependencies.
+template<class Backend>
+uint32_t SubmitP1Overlap(const rotating::RuntimeShape& shape, uint32_t availableAivs,
+    void* scoreStream, void* serviceStream, void* const* ready, uint32_t readyCount,
+    void* serviceDone, Backend& backend) {
+    constexpr uint32_t invalid = 100000;
+    const uint32_t blocks = P1ServiceBlocks(shape.batch,availableAivs);
+    const bool overlap = scoreStream != serviceStream;
+    // RuntimeShape has a fixed all-integer ABI. Recompute derived fields
+    // before enqueueing instead of trusting inconsistent lane geometry.
+    static_assert(std::has_unique_object_representations<rotating::RuntimeShape>::value);
+    auto prepared = shape;
+    if (!scoreStream || !serviceStream || !blocks ||
+        rotating::PrepareShape(&prepared) != 0 || std::memcmp(&prepared,&shape,sizeof(shape)) != 0 ||
+        !rotating::UseSequenceSplit(shape) ||
+        shape.serviceLanes > availableAivs-2*shape.batch ||
+        (overlap && (!ready || readyCount < shape.rounds || !serviceDone))) return invalid;
+    uint32_t covered = 0;
+    for (uint32_t epoch=0; epoch<shape.rounds; ++epoch) {
+        auto wave = PlanWindow(shape,epoch,1);
+        if (wave.begin != covered || wave.parts != 1 ||
+            !ValidWindow(shape.batch,wave.begin,wave.end,1,shape.aicCount) ||
+            (overlap && (!ready[epoch] || ready[epoch]==serviceDone))) return invalid;
+        covered = wave.end;
+        if (overlap) for (uint32_t earlier=0; earlier<epoch; ++earlier) {
+            if (ready[epoch]==ready[earlier]) return invalid;
+        }
+    }
+    if (covered != shape.history) return invalid;
+    for (uint32_t epoch=0; epoch<shape.rounds; ++epoch) {
+        auto wave = PlanWindow(shape,epoch,1);
+        uint32_t result = backend.Score(scoreStream,wave,epoch);
+        if (!result && epoch==0) result = backend.Resident(scoreStream);
+        if (!result && overlap) result = backend.Record(scoreStream,ready[epoch]);
+        if (!result && overlap) result = backend.Wait(serviceStream,ready[epoch]);
+        if (!result) result = backend.TopK(serviceStream,blocks,wave,epoch);
+        if (!result) result = backend.Post(serviceStream,wave,epoch);
+        if (result) return result;
+    }
+    if (overlap) {
+        uint32_t result = backend.Record(serviceStream,serviceDone);
+        if (!result) result = backend.Wait(scoreStream,serviceDone);
+        if (result) return result;
+    }
+    return backend.Finish(scoreStream);
+}
+}
