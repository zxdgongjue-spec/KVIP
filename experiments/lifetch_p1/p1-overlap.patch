+namespace {
+struct P1Backend {
+    void* bindings;
+    void* workspace;
+    const rotating::RuntimeShape& shape;
+    uint32_t resolveBlocks;
+    uint32_t Score(void* stream,const kvip_score_t2::Window& wave,uint32_t epoch) {
+        return aclrtlaunch_v9_li_kernel_score_window_t2(shape.batch,stream,bindings,1,wave.begin,wave.end,epoch!=0);
+    }
+    uint32_t Resident(void* stream) { return aclrtlaunch_v9_li_kernel_1(shape.liCores,stream,bindings); }
+    uint32_t Record(void* stream,void* event) { return aclrtRecordEvent(event,stream); }
+    uint32_t Wait(void* stream,void* event) { return aclrtStreamWaitEvent(stream,event); }
+    uint32_t TopK(void* stream,uint32_t blocks,const kvip_score_t2::Window& wave,uint32_t epoch) {
+        return aclrtlaunch_v9_li_window_topk_paired(blocks,stream,bindings,epoch,wave.end0,wave.end1);
+    }
+    uint32_t Post(void* stream,const kvip_score_t2::Window& wave,uint32_t epoch) {
+        return aclrtlaunch_v9_li_window_post(shape.serviceLanes,stream,bindings,epoch,wave.end0,wave.end1);
+    }
+    uint32_t Finish(void* stream) {
+        uint32_t result=aclrtlaunch_v9_li_kernel_3(shape.liCores,stream,bindings);
+        if (!result) result=aclrtlaunch_v9_streaming_resolve_update(resolveBlocks,stream,workspace);
+        return result;
+    }
+};
+}
+extern "C" uint32_t kvip_lifetch_score_p1_overlap_forward(void* bindings,void* update,void* workspace,
+    void* scoreStream,void* serviceStream,void* const* scoreReady,uint32_t readyCount,
+    void* serviceDone,const rotating::RuntimeShape* shape,uint32_t workers,uint32_t availableAivs) {
+    if (!bindings || !update || !workspace || !shape || shape->finalWorkers!=4 ||
+        shape->resident>131072 || !rotating::UseSequenceSplit(*shape) || shape->liCores!=2*shape->batch ||
+        !shape->serviceLanes || (workers!=1 && workers!=2 && workers!=4)) return 100000;
+    auto resolveBlocks=shape->batch*pipeline_ab::kResolveCores+4*workers;
+    if (resolveBlocks>availableAivs || shape->liCores*2>availableAivs) return 100000;
+    P1Backend backend{bindings,workspace,*shape,resolveBlocks};
+    return kvip_score_t2::SubmitP1Overlap(*shape,availableAivs,scoreStream,serviceStream,
+        scoreReady,readyCount,serviceDone,backend);
+}
