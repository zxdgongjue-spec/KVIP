+                            2047U, 4097U, 12516U, 32767U}) {
+        const auto baseline = TracePost<false>(f, 37, count, first, initial_pi);
+        const auto bulk = TracePost<true>(f, 37, count, first, initial_pi);
+        CHECK(baseline.wqes == bulk.wqes);
+        CHECK(baseline.last_wqe == bulk.last_wqe);
+        CHECK(bulk.doorbells <= baseline.doorbells);
+        CHECK(bulk.vf_calls == bulk.doorbells);
+        CHECK(bulk.dma_calls <= baseline.dma_calls);
+        if (count > 64) CHECK(bulk.doorbells < baseline.doorbells);
+      }
