+template <bool Bulk>
+PostTrace TracePost(Fixture& f, uint32_t begin, uint32_t count,
+                   uint32_t first_jetty, uint64_t initial_pi) {
+  CHECK(aiv_model::completed_dma == aiv_model::pending_dma.size());
+  for (size_t j = 0; j < f.queues.size(); ++j) {
+    auto& q = f.queues[j];
+    auto& h = aiv_model::hardware[j];
+    q = {};
+    q.sq_producer_index = initial_pi;
+    h.producer = h.completed = initial_pi;
+    h.sq_db = static_cast<uint32_t>(initial_pi);
+    h.cq_producer = h.cq_consumer = h.cq_db = 0;
+    h.posted_wqes.clear();
+    CHECK(h.checkpoints.empty());
+    std::fill(h.sq.begin(), h.sq.end(), 0U);
+    h.cq.fill(0U);
+  }
+  const auto doorbells = aiv_model::doorbells;
+  const auto vfs = aiv_model::vf_calls;
+  const auto dmas = aiv_model::dma_calls;
+  uint64_t first_cycle = 0, last = 0;
+  ConfigureUbToGmCopy();
+  PostDirectRequests<Bulk>(f.indices.data(), f.rows.data(), f.offsets.data(),
+      f.addresses.data(), begin, count, first_jetty, f.args.token_bytes,
+      f.jettys, f.entities.data(), f.queues.data(), 1, &first_cycle, &last);
+  CHECK(aiv_model::completed_dma == aiv_model::pending_dma.size());
+  PostTrace trace{{}, aiv_model::doorbells - doorbells, aiv_model::vf_calls - vfs,
+                  aiv_model::dma_calls - dmas, last};
+  for (uint32_t j = 0; j < f.jettys; ++j) {
+    auto& h = aiv_model::hardware[j];
+    trace.wqes.push_back(h.posted_wqes);
+    // Each participating Jetty still has exactly one original tail CQ.
+    CHECK(h.checkpoints.size() == static_cast<size_t>(!h.posted_wqes.empty()));
+    if (!h.posted_wqes.empty()) {
+      uint32_t polls = 0;
+      CHECK(WaitForCompletion(&f.entities[j], &f.queues[j], &polls) == kSuccess);
+      CHECK(h.completed == h.producer);
+    }
