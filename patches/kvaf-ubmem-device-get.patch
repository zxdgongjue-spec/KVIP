diff --git a/access_operator/include/ubmem/fused_batch_get_device.h b/access_operator/include/ubmem/fused_batch_get_device.h
new file mode 100644
index 00000000..84e7c1d5
--- /dev/null
+++ b/access_operator/include/ubmem/fused_batch_get_device.h
@@ -0,0 +1,62 @@
+#pragma once
+#include "ubmem/copy.h"
+
+namespace kvaf_device {
+// Compact descriptors are the same resolver outputs used by URMA: one remote
+// address and one absolute output row per request. The caller ensures the
+// descriptor-producing kernel has completed before entering this overload.
+struct UbmemBatchGetDeviceArgs {
+  __gm__ const uint64_t* addresses;
+  __gm__ const int32_t* output_indices;
+  uint64_t peer_base, mapped_base, region_bytes, output_base, output_bytes;
+  uint32_t begin, count, owner_base, resident, worker, workers, token_bytes;
+};
+struct UbmemBatchGetDeviceResult {
+  uint32_t scheduled, completed, error;
+};
+
+// Workers own complete destination sectors. Consecutive 656-byte rows share
+// a 32-byte sector, so both rows of a pair must be handled by one worker.
+__aicore__ inline UbmemBatchGetDeviceResult KvafBatchGetDevice(
+    const UbmemBatchGetDeviceArgs& a, AscendC::LocalTensor<uint8_t> scratch) {
+  UbmemBatchGetDeviceResult result{};
+  if (!a.addresses || !a.output_indices || !a.workers || a.worker >= a.workers || !a.token_bytes ||
+      !a.peer_base || !a.mapped_base || !a.region_bytes ||
+      a.region_bytes > UINT64_MAX - a.peer_base || a.region_bytes > UINT64_MAX - a.mapped_base ||
+      !a.output_base || !a.output_bytes || a.output_bytes > UINT64_MAX - a.output_base ||
+      (a.output_base & 31U) || a.token_bytes > a.region_bytes || a.token_bytes > a.output_bytes ||
+      a.count > UINT32_MAX - a.begin) {
+    result.error = 0x20000U;
+    return result;
+  }
+  kvaf::ubmem::MteCopyPipeline<4, 21504> pipeline(a.token_bytes, scratch);
+  bool started = false;
+  for (uint32_t rank = 0; rank < a.count; ++rank) {
+    const uint32_t index = a.begin + rank;
+    const int32_t output_index = a.output_indices[index];
+    const bool valid_slot = output_index >= 0 && uint32_t(output_index) >= a.owner_base &&
+                            uint32_t(output_index) - a.owner_base < a.resident;
+    const uint32_t slot = valid_slot ? uint32_t(output_index) - a.owner_base : 0;
+    const uint32_t owner = valid_slot ? (slot >> 1U) % a.workers : rank % a.workers;
+    if (owner != a.worker) continue;
+    ++result.scheduled;
+    if (result.error) continue;
+    const uint64_t peer = a.addresses[index];
+    const uint64_t output_offset = uint64_t(uint32_t(output_index)) * a.token_bytes;
+    if (!valid_slot || peer < a.peer_base || peer - a.peer_base > a.region_bytes - a.token_bytes ||
+        output_offset > a.output_bytes - a.token_bytes) {
+      result.error |= 0x20000U;
+      continue;
+    }
+    if (!started) {
+      AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(0);
+      AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(0);
+      started = true;
+    }
+    pipeline.Copy(a.output_base + output_offset, a.mapped_base + (peer - a.peer_base), a.token_bytes);
+    ++result.completed;
+  }
+  pipeline.Finish();
+  return result;
+}
+}  // namespace kvaf_device
