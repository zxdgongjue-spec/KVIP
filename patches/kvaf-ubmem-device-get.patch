diff --git a/access_operator/include/ubmem/fused_batch_get_device.h b/access_operator/include/ubmem/fused_batch_get_device.h
new file mode 100644
index 00000000..2c324c0c
--- /dev/null
+++ b/access_operator/include/ubmem/fused_batch_get_device.h
@@ -0,0 +1,62 @@
+#pragma once
+#include "ubmem/copy.h"
+
+namespace kvaf_device {
+// A fused resolver has already selected and deduplicated these rows. The three
+// local arrays remain owned by its calling AIV until this function returns.
+struct UbmemBatchGetDeviceArgs {
+  AscendC::LocalTensor<uint32_t> remote_low, remote_high, slots;
+  uint64_t peer_base, mapped_base, region_bytes, output, output_base, output_bytes;
+  uint32_t count, resident, worker, workers, token_bytes;
+};
+struct UbmemBatchGetDeviceResult {
+  uint32_t scheduled, completed, error;
+};
+
+// Overload of the existing device entry for UBmem. A worker scans the immutable
+// plan and owns whole 32-byte destination sectors, including 656-byte rows.
+// Caller-provided scratch and event IDs 0..3 must be unused for the duration.
+__aicore__ inline UbmemBatchGetDeviceResult KvafBatchGetDevice(
+    const UbmemBatchGetDeviceArgs& a, AscendC::LocalTensor<uint8_t> scratch) {
+  UbmemBatchGetDeviceResult result{};
+  if (!a.workers || a.worker >= a.workers || !a.token_bytes ||
+      !a.peer_base || !a.mapped_base || !a.region_bytes ||
+      a.region_bytes > UINT64_MAX - a.peer_base || a.region_bytes > UINT64_MAX - a.mapped_base ||
+      !a.output_base || !a.output_bytes || a.output_bytes > UINT64_MAX - a.output_base || (a.output & 31U) ||
+      a.output < a.output_base || a.token_bytes > a.region_bytes || a.token_bytes > a.output_bytes) {
+    result.error = 0x20000U;
+    return result;
+  }
+  kvaf::ubmem::MteCopyPipeline<4, 21504> pipeline(a.token_bytes, scratch);
+  bool started = false;
+  for (uint32_t rank = 0; rank < a.count; ++rank) {
+    const uint32_t slot = a.slots.GetValue(rank);
+    if (((slot >> 1U) % a.workers) != a.worker) continue;
+    ++result.scheduled;
+    // Match the existing completion contract: drain already issued copies,
+    // but do not issue any further requests once this worker sees an error.
+    if (result.error) continue;
+    const uint64_t peer = uint64_t(a.remote_low.GetValue(rank)) |
+                          (uint64_t(a.remote_high.GetValue(rank)) << 32U);
+    const uint64_t out_offset = a.output - a.output_base;
+    const uint64_t slot_offset = uint64_t(slot) * a.token_bytes;
+    if (slot >= a.resident || peer < a.peer_base || peer - a.peer_base > a.region_bytes - a.token_bytes ||
+        out_offset > a.output_bytes - a.token_bytes ||
+        slot_offset > a.output_bytes - a.token_bytes - out_offset) {
+      result.error |= 0x20000U;
+      continue;
+    }
+    if (!started) {
+      // The caller has consumed resolver metadata from UB. Fence scalar work
+      // before reusing the retired tensor for MTE2.
+      AscendC::SetFlag<AscendC::HardEvent::S_MTE2>(0);
+      AscendC::WaitFlag<AscendC::HardEvent::S_MTE2>(0);
+      started = true;
+    }
+    pipeline.Copy(a.output + slot_offset, a.mapped_base + (peer - a.peer_base), a.token_bytes);
+    ++result.completed;
+  }
+  pipeline.Finish();
+  return result;
+}
+}  // namespace kvaf_device
