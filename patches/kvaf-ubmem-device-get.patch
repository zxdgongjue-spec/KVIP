diff --git a/tests/ubmem_device_stub/kernel_operator.h b/tests/ubmem_device_stub/kernel_operator.h
new file mode 100644
index 00000000..82a35c6c
--- /dev/null
+++ b/tests/ubmem_device_stub/kernel_operator.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+#define __aicore__
+#define __gm__
+using event_t = unsigned;
+namespace AscendC {
+enum class TPosition { VECIN };
+enum class HardEvent { MTE3_MTE2, MTE2_MTE3, MTE3_S, S_MTE2 };
+inline bool events[4][8]{};
+template<HardEvent D> void SetFlag(event_t e) { assert(e<8); assert(!events[unsigned(D)][e]); events[unsigned(D)][e]=true; }
+template<HardEvent D> void WaitFlag(event_t e) { assert(e<8); assert(events[unsigned(D)][e]); events[unsigned(D)][e]=false; }
+template<class T> struct LocalTensor {
+    struct { uint8_t logicPos; uint32_t bufferAddr, dataLen; } address_{};
+    T* data{};
+    LocalTensor operator[](size_t offset) const { auto out=*this; out.data+=offset; return out; }
+    T GetValue(size_t index) const { return data[index]; }
+};
+template<class T> struct GlobalTensor { T* data{}; void SetGlobalBuffer(T* p) {data=p;} };
+struct DataCopyExtParams { uint16_t blockCount; uint32_t blockLen, srcStride, dstStride, reserved; };
+template<class T> struct DataCopyPadExtParams { bool enabled; uint8_t left, right; T value; };
+template<class T> void DataCopyPad(LocalTensor<T> dst, GlobalTensor<T> src, DataCopyExtParams c, DataCopyPadExtParams<T>) {
+    assert(c.blockCount==1); std::memcpy(dst.data,src.data,c.blockLen);
+}
+template<class T> void DataCopyPad(GlobalTensor<T> dst, LocalTensor<T> src, DataCopyExtParams c) {
+    assert(c.blockCount==1); std::memcpy(dst.data,src.data,c.blockLen);
+}
+}
diff --git a/tests/ubmem_fused_device_test.cc b/tests/ubmem_fused_device_test.cc
new file mode 100644
index 00000000..ed3ec0ae
--- /dev/null
+++ b/tests/ubmem_fused_device_test.cc
@@ -0,0 +1,62 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include "ubmem/fused_batch_get_device.h"
+#include <cassert>
+#include <cstdint>
+#include <vector>
+int main() {
+  for (uint32_t width : {656U, 2624U}) {
+    constexpr uint32_t rows=16, workers=4;
+    std::vector<uint8_t> source(rows*width), storage(rows*width+31, 0), expected(rows*width,0), scratch(21504);
+    auto* output=reinterpret_cast<uint8_t*>((reinterpret_cast<uintptr_t>(storage.data())+31U)&~uintptr_t(31U));
+    for (size_t i=0;i<source.size();++i) source[i]=uint8_t(i*17U);
+    uint64_t addresses[rows]; int32_t slots[rows];
+    for (uint32_t i=0;i<rows;++i) {
+      uint64_t peer=0x100000ULL+uint64_t(i)*width;
+      addresses[i]=peer; slots[i]=(i*5)%rows;
+      std::memcpy(expected.data()+uint64_t(slots[i])*width,source.data()+uint64_t(i)*width,width);
+    }
+    uint32_t total=0;
+    for (uint32_t w=0;w<workers;++w) {
+      kvaf_device::UbmemBatchGetDeviceArgs args{addresses,slots,0x100000ULL,
+        reinterpret_cast<uint64_t>(source.data()),source.size(),reinterpret_cast<uint64_t>(output),rows*width,
+        0,rows,0,rows,w,workers,width};
+      auto result=kvaf_device::KvafBatchGetDevice(args,AscendC::LocalTensor<uint8_t>{{},scratch.data()});
+      assert(result.error==0 && result.scheduled==result.completed); total+=result.completed;
+    }
+    assert(total==rows && std::memcmp(output,expected.data(),expected.size())==0);
+    for(auto& dir:AscendC::events)for(bool flag:dir)assert(!flag);
+    kvaf_device::UbmemBatchGetDeviceArgs invalid{addresses,slots,0x100000ULL,
+      reinterpret_cast<uint64_t>(source.data()),source.size(),reinterpret_cast<uint64_t>(output),rows*width,
+      0,rows,0,rows,0,workers,width};
+    addresses[0]=0;auto result=kvaf_device::KvafBatchGetDevice(invalid,AscendC::LocalTensor<uint8_t>{{},scratch.data()});
+    assert(result.error!=0 && result.completed==0 && result.scheduled>0);
+
+    // Descriptor ranges and owner rows are not necessarily zero in a batch.
+    constexpr uint32_t begin=3, owner=16;
+    std::vector<uint64_t> shifted_addresses(begin+rows);
+    std::vector<int32_t> shifted_slots(begin+rows);
+    std::vector<uint8_t> shifted_storage((owner+rows)*width+31,0), shifted_expected((owner+rows)*width,0);
+    auto* shifted_output=reinterpret_cast<uint8_t*>((reinterpret_cast<uintptr_t>(shifted_storage.data())+31U)&~uintptr_t(31U));
+    for(uint32_t i=0;i<rows;++i) {
+      shifted_addresses[begin+i]=0x100000ULL+uint64_t(i)*width;
+      shifted_slots[begin+i]=owner+(i*5)%rows;
+      std::memcpy(shifted_expected.data()+uint64_t(shifted_slots[begin+i])*width,source.data()+uint64_t(i)*width,width);
+    }
+    total=0;
+    for(uint32_t w=0;w<workers;++w) {
+      kvaf_device::UbmemBatchGetDeviceArgs args{shifted_addresses.data(),shifted_slots.data(),0x100000ULL,
+        reinterpret_cast<uint64_t>(source.data()),source.size(),reinterpret_cast<uint64_t>(shifted_output),shifted_expected.size(),
+        begin,rows,owner,rows,w,workers,width};
+      auto actual=kvaf_device::KvafBatchGetDevice(args,AscendC::LocalTensor<uint8_t>{{},scratch.data()});
+      assert(actual.error==0 && actual.scheduled==actual.completed);total+=actual.completed;
+    }
+    assert(total==rows && std::memcmp(shifted_output,shifted_expected.data(),shifted_expected.size())==0);
+    shifted_slots[begin]=-1;
+    kvaf_device::UbmemBatchGetDeviceArgs bad_slot{shifted_addresses.data(),shifted_slots.data(),0x100000ULL,
+      reinterpret_cast<uint64_t>(source.data()),source.size(),reinterpret_cast<uint64_t>(shifted_output),shifted_expected.size(),
+      begin,rows,owner,rows,0,workers,width};
+    assert(kvaf_device::KvafBatchGetDevice(bad_slot,AscendC::LocalTensor<uint8_t>{{},scratch.data()}).error!=0);
+  }
+}
