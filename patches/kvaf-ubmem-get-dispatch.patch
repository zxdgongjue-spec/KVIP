diff --git a/access_operator/ubmem/kernel/batch_get_tiled.asc b/access_operator/ubmem/kernel/batch_get_tiled.asc
new file mode 100644
index 0000000..d59fcc0
--- /dev/null
+++ b/access_operator/ubmem/kernel/batch_get_tiled.asc
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "get_dispatch.h"
+
+using namespace AscendC;
+using namespace kvaf_ubmem;
+
+namespace {
+// Same source checks and exact-length DMA as the legacy kernel. This object
+// changes only how an owner reaches its requests, not the request/table ABI.
+__aicore__ inline uint64_t CopyOwnedRequest(kvaf_ubmem_device::TiledGetCopier& copy,
+    const GetArgs& args, uint32_t request, uint32_t row) {
+  const int32_t index = copy.Load<int32_t>(args.indices + uint64_t(request) * 4);
+  const int32_t offset = copy.Load<int32_t>(args.offsets + uint64_t(request) * 4);
+  if (index < 0 || static_cast<uint32_t>(index) >= args.table_capacity ||
+      copy.Load<uint8_t>(args.valid_table + index) == 0) return kInvalidLookup;
+  const uint64_t base = copy.Load<uint64_t>(args.address_table + uint64_t(index) * 8);
+  const uint64_t blockBytes = uint64_t(args.tokens_per_block) * args.token_bytes;
+  if (offset < 0 || static_cast<uint32_t>(offset) % args.token_bytes != 0 ||
+      !ValidOffset(blockBytes, static_cast<uint32_t>(offset), args.token_bytes) ||
+      !Contains(args.region_base, args.region_bytes, base, blockBytes) ||
+      args.slot_bytes == 0 || (base - args.region_base) % args.slot_bytes != 0 ||
+      blockBytes > args.slot_bytes) return kInvalidSource;
+  copy.Copy(base + static_cast<uint32_t>(offset),
+            args.output + uint64_t(row) * args.token_bytes, args.token_bytes);
+  return kSuccess;
+}
+}
+
+extern "C" __global__ __aicore__ void KvafUbmemBatchGet(GetArgs args) {
+  kvaf_ubmem_device::TiledGetCopier copy;
+  copy.InvalidateMetadata(args.miss_count);
+  const uint32_t core = GetBlockIdx();
+  uint64_t result = kSuccess, failed = UINT64_MAX, copied = 0;
+  if (args.abi_version != kAbiVersion || args.workers == 0 ||
+      args.workers > kMaxWorkers || core >= args.workers ||
+      (args.token_bytes != 656 && args.token_bytes != 2624)) result = kInvalidAbi;
+  const int32_t count = result == kSuccess ? copy.Load<int32_t>(args.miss_count) : 0;
+  if (count < 0 || static_cast<uint32_t>(count) > args.request_capacity) result = kInvalidCount;
+  if (args.workers && !(args.workers & (args.workers - 1))) {
+    auto local = copy.DispatchWorkspace();
+    for (uint32_t begin = 0; result == kSuccess && begin < uint32_t(count);) {
+      const uint32_t remaining = uint32_t(count) - begin;
+      const uint32_t size = remaining < kvaf_ubmem_device::kDispatchTile
+          ? remaining : kvaf_ubmem_device::kDispatchTile;
+      const auto tile = kvaf_ubmem_device::LoadDispatchTile(copy, args, begin, size, core);
+      for (uint32_t rank = 0; result == kSuccess && rank < tile.count; ++rank) {
+        const uint32_t position = local.GetValue(kvaf_ubmem_device::kDispatchTile + rank);
+        if (position >= tile.firstInvalid) break;
+        const uint32_t request = begin + position;
+        result = CopyOwnedRequest(copy, args, request, local.GetValue(position));
+        if (result != kSuccess) failed = request;
+        else ++copied;
+      }
+      if (result == kSuccess && tile.firstInvalid != UINT32_MAX) {
+        result = kInvalidDestination; failed = begin + tile.firstInvalid;
+      }
+      begin += size;
+    }
+  } else {
+    // Arbitrary worker counts retain the scalar modulo rule without guessing
+    // an integer-vector division capability on the target architecture.
+    for (uint32_t i = 0; result == kSuccess && i < uint32_t(count); ++i) {
+      const int32_t row = copy.Load<int32_t>(args.output_indices + uint64_t(i) * 4);
+      if (row < 0 || uint32_t(row) >= args.output_rows) {
+        result = kInvalidDestination; failed = i; break;
+      }
+      if (OutputOwner(row, args.token_bytes, args.workers) != core) continue;
+      result = CopyOwnedRequest(copy, args, i, uint32_t(row));
+      if (result != kSuccess) failed = i;
+      else ++copied;
+    }
+  }
+  copy.Finish();
+  copy.WriteStatus(args.status == 0 ? 0 : args.status + core * sizeof(CoreStatus), result, failed, copied);
+}
+
+#if !defined(KVAF_UBMEM_CPU_MODEL)
+static const struct FunLevelKType KvafUbmemBatchGet_kernel_type_section
+    __attribute__((used, section(".ascend.meta.KvafUbmemBatchGet"))) =
+        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
+#endif
diff --git a/access_operator/ubmem/kernel/get_dispatch.h b/access_operator/ubmem/kernel/get_dispatch.h
new file mode 100644
index 0000000..a3b12b5
--- /dev/null
+++ b/access_operator/ubmem/kernel/get_dispatch.h
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "copy_primitives.h"
+
+namespace kvaf_ubmem_device {
+constexpr uint32_t kDispatchTile = 1024;
+constexpr uint32_t kDispatchBytes = (2 * kDispatchTile + 64) * sizeof(uint32_t);
+static_assert(8 * 2624 + 32 + kDispatchBytes <= kGetLocalMemoryBytes,
+              "Get payload ring and dispatch metadata must fit the registered UB");
+using TiledGetCopier = CopyPipeline<2624, kDispatchBytes>;
+
+// Keep request positions, not payloads, in this vector pass. Stable compaction
+// preserves duplicate-destination order. The first invalid destination is
+// reduced independently so every owner stops at the same prefix as scalar Get.
+__simd_vf__ inline void SelectOwnedRequests(__ubuf__ uint32_t* selected,
+    __ubuf__ uint32_t* rows, __ubuf__ uint32_t* control, uint32_t count,
+    uint32_t outputRows, uint32_t ownerMask, uint32_t core, bool paired) {
+  using namespace AscendC::MicroAPI;
+  auto all = CreateMask<uint32_t, MaskPattern::ALL>();
+  RegTensor<uint32_t> row, owner, first, invalidPosition, packed, ownerBits;
+  RegTensor<int32_t> signedPosition;
+  auto& position = reinterpret_cast<RegTensor<uint32_t>&>(signedPosition);
+  Arange(signedPosition, int32_t(0));
+  Duplicate(first, UINT32_MAX);
+  Duplicate(ownerBits, ownerMask);
+  ClearSpr<AscendC::SpecialPurposeReg::AR>();
+  UnalignRegForStore store;
+  uint32_t remaining = count;
+  const uint32_t destinationBound = outputRows < 0x80000000U ? outputRows : 0x80000000U;
+  for (uint16_t offset = 0; offset < count; offset += 64) {
+    auto valid = UpdateMask<uint32_t>(remaining);
+    LoadAlign(row, rows + offset);
+    MaskReg invalid, owned, accepted;
+    CompareScalar<uint32_t, CMPMODE::GE>(invalid, row, destinationBound, valid);
+    Duplicate(invalidPosition, UINT32_MAX);
+    Select(invalidPosition, position, invalidPosition, invalid);
+    Min(first, first, invalidPosition, all);
+    ShiftRights(owner, row, int16_t(paired ? 1 : 0), all);
+    And(owner, owner, ownerBits, all);
+    CompareScalar<uint32_t, CMPMODE::EQ>(owned, owner, core, valid);
+    CompareScalar<uint32_t, CMPMODE::LT>(accepted, row, destinationBound, valid);
+    MaskAnd(owned, owned, accepted, valid);
+    Squeeze<uint32_t, AscendC::MicroAPI::GatherMaskMode::STORE_REG>(packed, position, owned);
+    StoreUnAlign<uint32_t, PostLiteral::POST_MODE_UPDATE>(selected, packed, store);
+    Adds(position, position, uint32_t(64), all);
+  }
+  StoreUnAlignPost(selected, store);
+  ReduceMin(first, first, all);
+  auto one = CreateMask<uint32_t, MaskPattern::VL1>();
+  StoreAlign(control, first, one);
+}
+
+struct DispatchTile {
+  uint32_t count;
+  uint32_t firstInvalid;
+};
+
+__aicore__ inline DispatchTile LoadDispatchTile(TiledGetCopier& copy,
+    const GetArgs& args, uint32_t begin, uint32_t count, uint32_t core) {
+  auto local = copy.DispatchWorkspace();
+  // Reuse is only after the preceding filter's V_S join. This event also
+  // makes the shared MTE2 engine wait before overwriting the metadata tile.
+  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
+  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
+  GlobalTensor<uint32_t> input;
+  input.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(args.output_indices) + begin);
+  DataCopyExtParams transfer{1, count * uint32_t(sizeof(uint32_t)), 0, 0, 0};
+  DataCopyPadExtParams<uint32_t> pad{false, 0, 0, 0};
+  DataCopyPad<uint32_t, PaddingMode::Normal>(local, input, transfer, pad);
+  SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
+  WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
+  SelectOwnedRequests(reinterpret_cast<__ubuf__ uint32_t*>(local[kDispatchTile].GetPhyAddr()),
+      reinterpret_cast<__ubuf__ uint32_t*>(local.GetPhyAddr()),
+      reinterpret_cast<__ubuf__ uint32_t*>(local[2 * kDispatchTile].GetPhyAddr()),
+      count, args.output_rows, args.workers - 1, core, args.token_bytes == 656);
+  SetFlag<HardEvent::V_S>(EVENT_ID0);
+  WaitFlag<HardEvent::V_S>(EVENT_ID0);
+  return {uint32_t(GetSpr<SpecialPurposeReg::AR>() / sizeof(uint32_t)),
+          local.GetValue(2 * kDispatchTile)};
+}
+}  // namespace kvaf_ubmem_device
diff --git a/access_operator/ubmem/tests/model/dispatch_micro_api.h b/access_operator/ubmem/tests/model/dispatch_micro_api.h
new file mode 100644
index 0000000..e241018
--- /dev/null
+++ b/access_operator/ubmem/tests/model/dispatch_micro_api.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <array>
+#include <algorithm>
+
+namespace AscendC {
+enum class SpecialPurposeReg { AR };
+inline uint32_t dispatchBytes=0,dispatchPacked=0;
+template<SpecialPurposeReg>void ClearSpr(){dispatchBytes=0;}
+template<SpecialPurposeReg>uint64_t GetSpr(){return dispatchBytes;}
+namespace MicroAPI {
+enum class MaskPattern{ALL,VL1};
+enum class CMPMODE{GE,LT,EQ};
+enum class GatherMaskMode{STORE_REG};
+enum class PostLiteral{POST_MODE_UPDATE};
+struct MaskReg{std::array<bool,64> bits{};};
+struct UnalignRegForStore{};
+template<class T>struct RegTensor{std::array<T,64> data{};};
+template<class T,MaskPattern Pattern>MaskReg CreateMask(){MaskReg m;for(unsigned i=0;i<64;++i)m.bits[i]=Pattern==MaskPattern::ALL || i==0;return m;}
+template<class T>MaskReg UpdateMask(uint32_t& left){MaskReg m;for(unsigned i=0;i<64;++i)m.bits[i]=i<left;left=left>64?left-64:0;return m;}
+template<class T>void LoadAlign(RegTensor<T>& out,const T* in){std::copy_n(in,64,out.data.begin());}
+template<class T>void Duplicate(RegTensor<T>& out,T value){out.data.fill(value);}
+template<class T>void Arange(RegTensor<T>& out,T first){for(unsigned i=0;i<64;++i)out.data[i]=first+T(i);}
+template<class T,CMPMODE Mode>void CompareScalar(MaskReg& out,const RegTensor<T>& in,T value,MaskReg mask){
+ for(unsigned i=0;i<64;++i)out.bits[i]=mask.bits[i] && (Mode==CMPMODE::GE?in.data[i]>=value:Mode==CMPMODE::LT?in.data[i]<value:in.data[i]==value);
+}
+template<class T>void Select(RegTensor<T>& out,const RegTensor<T>& yes,const RegTensor<T>& no,MaskReg m){for(unsigned i=0;i<64;++i)out.data[i]=m.bits[i]?yes.data[i]:no.data[i];}
+template<class T>void Min(RegTensor<T>& out,const RegTensor<T>& a,const RegTensor<T>& b,MaskReg m){for(unsigned i=0;i<64;++i)if(m.bits[i])out.data[i]=std::min(a.data[i],b.data[i]);}
+template<class T>void ReduceMin(RegTensor<T>& out,const RegTensor<T>& in,MaskReg m){T value=~T(0);for(unsigned i=0;i<64;++i)if(m.bits[i])value=std::min(value,in.data[i]);out.data.fill(value);}
+template<class T>void ShiftRights(RegTensor<T>& out,const RegTensor<T>& in,int16_t shift,MaskReg m){for(unsigned i=0;i<64;++i)if(m.bits[i])out.data[i]=in.data[i]>>shift;}
+template<class T>void And(RegTensor<T>& out,const RegTensor<T>& a,const RegTensor<T>& b,MaskReg m){for(unsigned i=0;i<64;++i)if(m.bits[i])out.data[i]=a.data[i]&b.data[i];}
+template<class T>void Adds(RegTensor<T>& out,const RegTensor<T>& in,T value,MaskReg m){for(unsigned i=0;i<64;++i)if(m.bits[i])out.data[i]=in.data[i]+value;}
+inline void MaskAnd(MaskReg& out,MaskReg a,MaskReg b,MaskReg valid){for(unsigned i=0;i<64;++i)out.bits[i]=a.bits[i]&&b.bits[i]&&valid.bits[i];}
+template<class T,GatherMaskMode>void Squeeze(RegTensor<T>& out,const RegTensor<T>& in,MaskReg m){dispatchPacked=0;for(unsigned i=0;i<64;++i)if(m.bits[i])out.data[dispatchPacked++]=in.data[i];}
+template<class T,PostLiteral>void StoreUnAlign(T*& out,const RegTensor<T>& in,UnalignRegForStore&){std::copy_n(in.data.begin(),dispatchPacked,out);out+=dispatchPacked;dispatchBytes+=dispatchPacked*sizeof(T);}
+template<class T>void StoreUnAlignPost(T*&,UnalignRegForStore&){}
+template<class T>void StoreAlign(T* out,const RegTensor<T>& in,MaskReg m){for(unsigned i=0;i<64;++i)if(m.bits[i])out[i]=in.data[i];}
+}
+}
diff --git a/access_operator/ubmem/tests/tiled_model_test.cc b/access_operator/ubmem/tests/tiled_model_test.cc
new file mode 100644
index 0000000..044c6bf
--- /dev/null
+++ b/access_operator/ubmem/tests/tiled_model_test.cc
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#define KVAF_UBMEM_DISPATCH_MODEL 1
+#define KvafUbmemBatchGet LegacyGet
+#include "../kernel/batch_get.asc"
+#undef KvafUbmemBatchGet
+#include "../kernel/batch_get_tiled.asc"
+#include <cstdlib>
+#include <iostream>
+
+using namespace kvaf_ubmem;
+uint64_t Address(const void* p){return reinterpret_cast<uintptr_t>(p);}
+
+void Compare(uint32_t width,uint32_t workers,uint32_t count,uint32_t fault) {
+  constexpr uint32_t outputRows=2051,blocks=7,tokens=3;
+  const uint64_t slot=uint64_t(width)*tokens;
+  std::vector<uint8_t> source(blocks*slot);
+  for(size_t i=0;i<source.size();++i)source[i]=uint8_t((i*17+i/13)%251);
+  std::array<uint64_t,blocks> addresses{};
+  std::array<uint8_t,blocks> valid{};valid.fill(1);
+  for(uint32_t b=0;b<blocks;++b)addresses[b]=Address(source.data())+b*slot;
+  // Capacity includes an invalid tail: neither implementation may inspect it.
+  std::vector<int32_t> indices(count+67,-999),offsets(count+67,-999),rows(count+67,-999);
+  for(uint32_t i=0;i<count;++i){
+    indices[i]=(i*3+1)%blocks;offsets[i]=(i%tokens)*width;rows[i]=(i*131+7)%outputRows;
+  }
+  if(count>1){rows[count-1]=rows[0];indices[count-1]=(indices[0]+1)%blocks;}
+  const uint32_t pivot=count>1024?1024:count/2;
+  if(count) {
+    switch(fault){
+      case 1: rows[pivot]=outputRows;break;
+      case 2: rows[pivot]=-1;break;
+      case 3: indices[0]=blocks;rows[pivot]=outputRows;break;
+      case 4: rows[0]=-1;indices[pivot]=blocks;break;
+      case 5: offsets[pivot]=1;break;
+      case 6: valid[indices[pivot]]=0;break;
+      case 7: addresses[indices[pivot]]=Address(source.data())+source.size()-1;break;
+    }
+  }
+  const size_t bytes=uint64_t(outputRows)*width;
+  const size_t allocation=(bytes+64+63)/64*64;
+  std::unique_ptr<uint8_t,decltype(&std::free)> storage(static_cast<uint8_t*>(std::aligned_alloc(64,allocation)),&std::free);
+  assert(storage);auto* output=storage.get()+32;
+  int32_t dynamicCount=int32_t(count);
+  GetArgs args{Address(addresses.data()),Address(valid.data()),Address(indices.data()),Address(offsets.data()),
+    Address(&dynamicCount),Address(rows.data()),Address(output),0,Address(source.data()),source.size(),slot,
+    blocks,uint32_t(indices.size()),outputRows,width,tokens,workers,kAbiVersion,0};
+  if(fault==8)dynamicCount=-1;
