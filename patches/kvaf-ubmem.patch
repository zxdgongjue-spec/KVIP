diff --git a/access_operator/ubmem/include/ubmem/transfer_abi.h b/access_operator/ubmem/include/ubmem/transfer_abi.h
new file mode 100644
index 0000000..7042998
--- /dev/null
+++ b/access_operator/ubmem/include/ubmem/transfer_abi.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <stdint.h>
+
+#ifndef KVAF_UBMEM_INLINE
+#define KVAF_UBMEM_INLINE inline
+#endif
+
+namespace kvaf_ubmem {
+
+constexpr uint32_t kAbiVersion = 1;
+constexpr uint32_t kMaxWorkers = 64;
+constexpr uint32_t kCopyChunkBytes = 8192;
+constexpr uint32_t kLocalMemoryBytes = 80 * 1024;
+constexpr uint32_t kGetLocalMemoryBytes = 32 * 1024;
+constexpr uint64_t kStatusMagic = 0x55424d454d303031ULL;
+
+enum Result : uint64_t {
+  kSuccess = 0,
+  kInvalidCount = 1,
+  kInvalidLookup = 2,
+  kInvalidSource = 3,
+  kInvalidDestination = 4,
+  kInvalidAbi = 5,
+};
+
+// Exactly one 32-byte write sector per core; do not share a partial sector.
+struct CoreStatus {
+  uint64_t magic;
+  uint64_t result;
+  uint64_t failed_request;
+  uint64_t copied_requests;
+};
+
+struct GetArgs {
+  uint64_t address_table, valid_table;
+  uint64_t indices, offsets, miss_count, output_indices;
+  uint64_t output, status;
+  uint64_t region_base, region_bytes, slot_bytes;
+  uint32_t table_capacity, request_capacity, output_rows;
+  uint32_t token_bytes, tokens_per_block, workers;
+  uint32_t abi_version, reserved;
+};
+
+struct PutEntry {
+  uint64_t input_offset, length, destination;
+};
+
+struct PutArgs {
+  uint64_t input, input_bytes, entries, status;
+  uint64_t region_base, region_bytes, slot_bytes;
+  uint32_t count, abi_version;
+};
+
+static_assert(sizeof(CoreStatus) == 32, "UBmem status ABI");
+static_assert(sizeof(GetArgs) == 120, "UBmem Get ABI");
+static_assert(sizeof(PutEntry) == 24, "UBmem Put metadata ABI");
+static_assert(sizeof(PutArgs) == 64, "UBmem Put ABI");
+
+// Subtraction checks avoid overflow even at the end of an address space.
+KVAF_UBMEM_INLINE bool Contains(uint64_t base, uint64_t bytes,
+                                 uint64_t address, uint64_t width) {
+  return base != 0 && bytes != 0 && width != 0 &&
+         bytes <= UINT64_MAX - base && address >= base &&
+         width <= bytes && address - base <= bytes - width;
+}
+
+KVAF_UBMEM_INLINE bool ValidOffset(uint64_t bytes, uint64_t offset,
+                                    uint64_t width) {
+  return width != 0 && width <= bytes && offset <= bytes - width;
+}
+
+// With a 32-byte-aligned output, 656-byte rows share a sector only with their
+// even/odd neighbor. 2624-byte rows are sector aligned. A duplicate output
+// index also has one owner and is processed in request order on that owner.
+KVAF_UBMEM_INLINE uint32_t OutputOwner(uint32_t row, uint32_t token_bytes,
+                                        uint32_t workers) {
+  return (token_bytes == 656 ? row / 2 : row) % workers;
+}
+
+}  // namespace kvaf_ubmem
diff --git a/access_operator/ubmem/kernel/batch_get.asc b/access_operator/ubmem/kernel/batch_get.asc
new file mode 100644
index 0000000..cf2e323
--- /dev/null
+++ b/access_operator/ubmem/kernel/batch_get.asc
@@ -0,0 +1,52 @@
+#include "copy_primitives.h"
+
+using namespace AscendC;
+using namespace kvaf_ubmem;
+
+extern "C" __global__ __aicore__ void KvafUbmemBatchGet(GetArgs args) {
+  kvaf_ubmem_device::GetCopier copy;
+  copy.InvalidateMetadata(args.miss_count);
+  const uint32_t core = GetBlockIdx();
+  uint64_t result = kSuccess, failed = UINT64_MAX, copied = 0;
+  if (args.abi_version != kAbiVersion || args.workers == 0 ||
+      args.workers > kMaxWorkers || core >= args.workers ||
+      (args.token_bytes != 656 && args.token_bytes != 2624)) {
+    result = kInvalidAbi;
+  }
+  const int32_t count = result == kSuccess ? copy.Load<int32_t>(args.miss_count) : 0;
+  if (count < 0 || static_cast<uint32_t>(count) > args.request_capacity) result = kInvalidCount;
+  for (uint32_t i = 0; result == kSuccess && i < static_cast<uint32_t>(count); ++i) {
+    const int32_t row = copy.Load<int32_t>(args.output_indices + uint64_t(i) * 4);
+    if (row < 0 || static_cast<uint32_t>(row) >= args.output_rows) {
+      result = kInvalidDestination; failed = i; break;
+    }
+    if (OutputOwner(row, args.token_bytes, args.workers) != core) continue;
+    const int32_t index = copy.Load<int32_t>(args.indices + uint64_t(i) * 4);
+    const int32_t offset = copy.Load<int32_t>(args.offsets + uint64_t(i) * 4);
+    if (index < 0 || static_cast<uint32_t>(index) >= args.table_capacity ||
+        copy.Load<uint8_t>(args.valid_table + index) == 0) {
+      result = kInvalidLookup; failed = i; break;
+    }
+    const uint64_t base = copy.Load<uint64_t>(args.address_table + uint64_t(index) * 8);
+    const uint64_t block_bytes = uint64_t(args.tokens_per_block) * args.token_bytes;
+    if (offset < 0 || static_cast<uint32_t>(offset) % args.token_bytes != 0 ||
+        !ValidOffset(block_bytes, static_cast<uint32_t>(offset), args.token_bytes) ||
+        !Contains(args.region_base, args.region_bytes, base, block_bytes) ||
+        args.slot_bytes == 0 || (base - args.region_base) % args.slot_bytes != 0 ||
+        block_bytes > args.slot_bytes) {
+      result = kInvalidSource; failed = i; break;
+    }
+    copy.Copy(base + static_cast<uint32_t>(offset),
+              args.output + uint64_t(row) * args.token_bytes, args.token_bytes);
+    ++copied;
+  }
+  copy.Finish();
+  copy.WriteStatus(args.status == 0 ? 0 : args.status + core * sizeof(CoreStatus),
+                   result, failed, copied);
+}
+
+#if !defined(KVAF_UBMEM_CPU_MODEL)
+static const struct FunLevelKType KvafUbmemBatchGet_kernel_type_section
+    __attribute__((used, section(".ascend.meta.KvafUbmemBatchGet"))) =
+        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
+#endif
diff --git a/access_operator/ubmem/kernel/batch_put.asc b/access_operator/ubmem/kernel/batch_put.asc
new file mode 100644
index 0000000..49112a5
--- /dev/null
+++ b/access_operator/ubmem/kernel/batch_put.asc
@@ -0,0 +1,49 @@
+#include "copy_primitives.h"
+
+using namespace AscendC;
+using namespace kvaf_ubmem;
+
+extern "C" __global__ __aicore__ void KvafUbmemBatchPut(PutArgs args) {
+  // Each aligned 8 KiB destination chunk has exactly one writer. Assign
+  // by physical slot/chunk, not request index, to preserve duplicate ordering.
+  // Unaligned public inputs retain the single-writer path selected by host.
+  const uint32_t core = GetBlockIdx(), workers = GetBlockNum();
+  kvaf_ubmem_device::ByteCopier copy;
+  copy.InvalidateMetadata(args.entries);
+  uint64_t result = args.abi_version == kAbiVersion ? kSuccess : kInvalidAbi;
+  uint64_t failed = UINT64_MAX, copied = 0;
+  for (uint32_t i = 0; result == kSuccess && i < args.count; ++i) {
+    const uint64_t entry = args.entries + uint64_t(i) * sizeof(PutEntry);
+    const uint64_t offset = copy.Load<uint64_t>(entry);
+    const uint64_t length = copy.Load<uint64_t>(entry + 8);
+    const uint64_t destination = copy.Load<uint64_t>(entry + 16);
+    if (!ValidOffset(args.input_bytes, offset, length)) {
+      result = kInvalidSource; failed = i; break;
+    }
+    if (!Contains(args.region_base, args.region_bytes, destination, length) ||
+        args.slot_bytes == 0 || length > args.slot_bytes ||
+        (destination - args.region_base) % args.slot_bytes != 0) {
+      result = kInvalidDestination; failed = i; break;
+    }
+    if (workers > 1 && (args.region_base % 32 || args.slot_bytes % 32)) {
+      result = kInvalidAbi; failed = i; break;
+    }
+    const uint64_t slot = (destination - args.region_base) / args.slot_bytes;
+    for (uint64_t chunk = 0; chunk < length; chunk += kCopyChunkBytes) {
+      if ((slot + chunk / kCopyChunkBytes) % workers != core) continue;
+      const uint64_t size = length - chunk < kCopyChunkBytes ? length - chunk : kCopyChunkBytes;
+      copy.Copy(args.input + offset + chunk, destination + chunk, size);
+    }
+    // Count each reservation once, after the owner submits its chunks.
+    // Host synchronizes *all* cores and checks every status before commit.
+    if (slot % workers == core) ++copied;
+  }
+  copy.Finish();
+  copy.WriteStatus(args.status + core * sizeof(CoreStatus), result, failed, copied);
+}
+
+#if !defined(KVAF_UBMEM_CPU_MODEL)
+static const struct FunLevelKType KvafUbmemBatchPut_kernel_type_section
+    __attribute__((used, section(".ascend.meta.KvafUbmemBatchPut"))) =
+        {{F_TYPE_KTYPE, sizeof(unsigned int), K_TYPE_AIV}};
+#endif
diff --git a/access_operator/ubmem/kernel/copy_primitives.h b/access_operator/ubmem/kernel/copy_primitives.h
new file mode 100644
index 0000000..6950c97
--- /dev/null
+++ b/access_operator/ubmem/kernel/copy_primitives.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include "kernel_operator.h"
+#define KVAF_UBMEM_INLINE __aicore__ inline
+#include "ubmem/transfer_abi.h"
+#undef KVAF_UBMEM_INLINE
+
+namespace kvaf_ubmem_device {
+using namespace AscendC;
+using namespace kvaf_ubmem;
+
+// Eight exact-length DMA stages overlap Host-DDR reads with HBM writes.
+// Destination owners serialize duplicate rows and shared partial sectors.
+// Drain every credit before returning, including on a validation failure.
+template <uint32_t StageBytes>
+class CopyPipeline {
+ public:
+  __aicore__ inline CopyPipeline() {
+    pipe_.InitBuffer(payload_, kDepth * kStageBytes);
+    pipe_.InitBuffer(control_, 32);
+  }
+
+  // Descriptors/tables live in HBM and can change between graph replays.
+  // Invalidate once per launch, then use scalar cache lines rather than one
+  // MTE2 transfer plus a scalar wait for each 1/4/8-byte field.
+  __aicore__ inline void InvalidateMetadata(uint64_t address) {
+    GlobalTensor<uint8_t> metadata;
+    metadata.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(address));
+    DataCacheCleanAndInvalid<uint8_t, CacheLine::ENTIRE_DATA_CACHE>(metadata);
+  }
+
+  template <typename T>
+  __aicore__ inline T Load(uint64_t address) {
+    GlobalTensor<T> source;
+    source.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address));
+    return source.GetValue(0);
+  }
+
+  __aicore__ inline void Copy(uint64_t source_address,
+                              uint64_t destination_address, uint64_t bytes) {
+    if (!issued_) {
+      SetFlag<HardEvent::S_MTE2>(EVENT_ID0);
+      WaitFlag<HardEvent::S_MTE2>(EVENT_ID0);
+      for (uint32_t i = 0; i < kDepth; ++i)
+        SetFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(i));
+    }
+    for (uint64_t offset = 0; offset < bytes;) {
+      const uint32_t size = static_cast<uint32_t>(
+          bytes - offset > kStageBytes ? kStageBytes : bytes - offset);
+      const uint32_t stage = issued_ % kDepth;
+      WaitFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(stage));
+      GlobalTensor<uint8_t> source;
+      source.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(source_address + offset));
+      DataCopyExtParams copy{1, size, 0, 0, 0};
+      DataCopyPadExtParams<uint8_t> pad{false, 0, 0, 0};
+      DataCopyPad<uint8_t, PaddingMode::Normal>(
+          payload_.Get<uint8_t>()[stage * kStageBytes], source, copy, pad);
+      SetFlag<HardEvent::MTE2_MTE3>(static_cast<event_t>(stage));
+      destinations_[stage] = destination_address + offset;
+      sizes_[stage] = size;
+      ++issued_;
+      if (issued_ - stored_ == kDepth) StoreOne();
+      offset += size;
+    }
+  }
+
+  __aicore__ inline void Finish() {
+    if (!issued_) return;
+    while (stored_ < issued_) StoreOne();
+    for (uint32_t i = 0; i < kDepth; ++i)
+      WaitFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(i));
+    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
+    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
+    issued_ = stored_ = 0;
+  }
+
+  __aicore__ inline void WriteStatus(uint64_t address, uint64_t result,
+                                      uint64_t failed, uint64_t copied) {
+    if (address == 0) return;
+    auto local = control_.Get<uint64_t>();
+    local.SetValue(0, kStatusMagic);
+    local.SetValue(1, result);
+    local.SetValue(2, failed);
+    local.SetValue(3, copied);
+    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
+    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
+    GlobalTensor<uint64_t> destination;
+    destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(address));
+    DataCopyExtParams copy{1, sizeof(CoreStatus), 0, 0, 0};
+    DataCopyPad<uint64_t, PaddingMode::Normal>(destination, local, copy);
+    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
+    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
+  }
+
+ private:
+  static constexpr uint32_t kDepth = 8;
+  static constexpr uint32_t kStageBytes = StageBytes;
+  __aicore__ inline void StoreOne() {
+    const uint32_t stage = stored_ % kDepth;
+    WaitFlag<HardEvent::MTE2_MTE3>(static_cast<event_t>(stage));
+    GlobalTensor<uint8_t> destination;
+    destination.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(destinations_[stage]));
+    DataCopyExtParams copy{1, sizes_[stage], 0, 0, 0};
+    DataCopyPad<uint8_t, PaddingMode::Normal>(
+        destination, payload_.Get<uint8_t>()[stage * kStageBytes], copy);
+    SetFlag<HardEvent::MTE3_MTE2>(static_cast<event_t>(stage));
+    ++stored_;
+  }
+  uint64_t destinations_[kDepth]{};
+  uint32_t sizes_[kDepth]{};
+  uint64_t issued_{0}, stored_{0};
+  TPipe pipe_;
+  TBuf<TPosition::VECCALC> payload_, control_;
+};
+using GetCopier = CopyPipeline<2624>;
+using ByteCopier = CopyPipeline<kCopyChunkBytes>;
+}  // namespace kvaf_ubmem_device
diff --git a/access_operator/ubmem/tests/copy_model_test.cc b/access_operator/ubmem/tests/copy_model_test.cc
new file mode 100644
index 0000000..5f38725
--- /dev/null
+++ b/access_operator/ubmem/tests/copy_model_test.cc
@@ -0,0 +1,158 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cstdlib>
+#include <iostream>
+#include <limits>
+#include <vector>
+
+#include "../kernel/batch_get.asc"
+#include "../kernel/batch_put.asc"
+
+using namespace kvaf_ubmem;
+uint64_t Address(const void* pointer) { return reinterpret_cast<uintptr_t>(pointer); }
+
+void RunGet(GetArgs args, CoreStatus* statuses) {
+  args.status = Address(statuses);
+  std::fill(statuses, statuses + args.workers, CoreStatus{});
+  for (uint32_t worker = 0; worker < args.workers; ++worker) {
+    ubmem_model::core = worker;
+    KvafUbmemBatchGet(args);
+    ubmem_model::CheckDrained();
+    assert(statuses[worker].magic == kStatusMagic);
+  }
+}
+
+void TestGet(uint32_t width, uint32_t workers) {
+  constexpr uint32_t rows = 513, block_rows = 3, blocks = 6;
+  const uint64_t slot = uint64_t(width) * block_rows;
+  std::vector<uint8_t> arena(slot * blocks);
+  for (size_t i = 0; i < arena.size(); ++i) arena[i] = (i * 29 + i / 7) % 251;
+  std::array<uint64_t, blocks> addresses{};
+  std::array<uint8_t, blocks> valid{};
+  for (uint32_t i = 0; i < blocks; ++i) { addresses[i] = Address(arena.data()) + i * slot; valid[i] = 1; }
+  std::array<int32_t, rows + 2> indices{}, offsets{}, output_rows{};
+  for (uint32_t i = 0; i < rows; ++i) {
+    indices[i] = i % blocks;
+    offsets[i] = (i % block_rows) * width;
+    output_rows[i] = (i * 7) % rows;
+  }
+  // Repeated destinations must execute on one owner in prefix order.
+  indices[rows] = 2; offsets[rows] = width; output_rows[rows] = 3;
+  // Unused capacity must never be inspected.
+  indices[rows + 1] = -999; offsets[rows + 1] = -999; output_rows[rows + 1] = -999;
+  int32_t count = rows + 1;
+  const size_t bytes = rows * width;
+  const size_t allocation = (bytes + 64 + 63) / 64 * 64;
+  std::unique_ptr<uint8_t, decltype(&std::free)> storage(
+      static_cast<uint8_t*>(std::aligned_alloc(64, allocation)), &std::free);
+  assert(storage);
+  std::memset(storage.get(), 0xa7, allocation);
+  auto* output = storage.get() + 32;
+  std::vector<uint8_t> expected(bytes, 0xa7);
+  for (int32_t i = 0; i < count; ++i) {
+    std::memcpy(expected.data() + output_rows[i] * width,
+        arena.data() + indices[i] * slot + offsets[i], width);
+  }
+  GetArgs args{Address(addresses.data()), Address(valid.data()), Address(indices.data()),
+      Address(offsets.data()), Address(&count), Address(output_rows.data()), Address(output), 0,
+      Address(arena.data()), arena.size(), slot, blocks, rows + 2, rows,
+      width, block_rows, workers, kAbiVersion, 0};
+  std::array<CoreStatus, kMaxWorkers> statuses{};
+  ubmem_model::TrackWrites(output, bytes);
+  RunGet(args, statuses.data());
+  uint64_t total = 0;
+  for (uint32_t i = 0; i < workers; ++i) { assert(statuses[i].result == kSuccess); total += statuses[i].copied_requests; }
+  assert(total == static_cast<uint32_t>(count));
+  assert(std::memcmp(output, expected.data(), bytes) == 0);
+  for (size_t i = 0; i < 32; ++i) assert(storage.get()[i] == 0xa7 && output[bytes + i] == 0xa7);
+  const auto before = expected;
+  count = 0;
+  RunGet(args, statuses.data());
+  assert(std::memcmp(output, before.data(), bytes) == 0);
+  count = -1;
+  RunGet(args, statuses.data());
+  for (uint32_t i = 0; i < workers; ++i) assert(statuses[i].result == kInvalidCount);
+  count = rows + 3;
+  RunGet(args, statuses.data());
+  for (uint32_t i = 0; i < workers; ++i) assert(statuses[i].result == kInvalidCount);
+  count = 1;
+  output_rows[0] = rows;
+  RunGet(args, statuses.data());
+  for (uint32_t i = 0; i < workers; ++i) assert(statuses[i].result == kInvalidDestination);
+  output_rows[0] = 0;
+  indices[0] = blocks;
+  RunGet(args, statuses.data()); assert(statuses[0].result == kInvalidLookup);
+  indices[0] = 0; valid[0] = 0;
+  RunGet(args, statuses.data()); assert(statuses[0].result == kInvalidLookup);
+  valid[0] = 1; offsets[0] = width * block_rows;
+  RunGet(args, statuses.data()); assert(statuses[0].result == kInvalidSource);
+  offsets[0] = 1;
+  RunGet(args, statuses.data()); assert(statuses[0].result == kInvalidSource);
+  offsets[0] = 0; addresses[0] = Address(arena.data()) + arena.size() - 1;
+  RunGet(args, statuses.data()); assert(statuses[0].result == kInvalidSource);
+  ubmem_model::TrackWrites(nullptr, 0);
+}
+
+void TestPut(uint64_t slot, uint32_t workers) {
+  const std::vector<uint64_t> sizes{1, 15, 31, 32, 33, 655, 656, 2624, 8191, 8192, 8193, 13003, 128 * 656, 128 * 2624, 10 * 8192 + 17};
+  std::vector<uint8_t> arena(slot * sizes.size() + 128, 0xb9), source(1000000, 0);
+  for (size_t i = 0; i < source.size(); ++i) source[i] = (i * 17 + i / 11) % 253;
+  std::vector<PutEntry> entries;
+  const uint64_t prefix = 32 + (32 - Address(arena.data()) % 32) % 32;
+  auto expected = arena;
+  uint64_t offset = 3;
+  for (size_t i = 0; i < sizes.size(); ++i) {
+    entries.push_back({offset, sizes[i], Address(arena.data() + prefix + i * slot)});
+    std::memcpy(expected.data() + prefix + i * slot, source.data() + offset, sizes[i]);
+    offset += sizes[i] + 5;
+  }
+  // Repeat a destination with different bytes/length. Every chunk must
+  // remain on its original owner and preserve submission order.
+  entries.push_back({13, slot - 17, Address(arena.data() + prefix)});
+  std::memcpy(expected.data() + prefix, source.data() + 13, slot - 17);
+  std::array<CoreStatus, kMaxWorkers> statuses{};
+  auto& status = statuses[0];
+  PutArgs args{Address(source.data()), source.size(), Address(entries.data()), Address(&status),
+      Address(arena.data() + prefix), slot * sizes.size(), slot, static_cast<uint32_t>(entries.size()), kAbiVersion};
+  ubmem_model::core = 0;
+  ubmem_model::TrackWrites(arena.data() + prefix, slot * sizes.size());
+  ubmem_model::workers = workers;
+  uint64_t total = 0;
+  for (uint32_t i = 0; i < workers; ++i) {
+    ubmem_model::core = i;
+    KvafUbmemBatchPut(args);
+    ubmem_model::CheckDrained();
+    assert(statuses[i].magic == kStatusMagic && statuses[i].result == kSuccess);
+    total += statuses[i].copied_requests;
+  }
+  assert(total == entries.size());
+  ubmem_model::core = 0;
+  assert(arena == expected);
+  args.count = 1;
+  entries[0].length = 0;
+  KvafUbmemBatchPut(args); assert(status.result == kInvalidSource);
+  entries[0].length = 2; entries[0].input_offset = source.size() - 1;
+  KvafUbmemBatchPut(args); assert(status.result == kInvalidSource);
+  entries[0].input_offset = 0; entries[0].destination = args.region_base + args.region_bytes - 1;
+  KvafUbmemBatchPut(args); assert(status.result == kInvalidDestination);
+  assert(arena == expected);
+  ubmem_model::CheckDrained();
+  ubmem_model::TrackWrites(nullptr, 0);
+}
+
+int main() {
+  assert(!Contains(UINT64_MAX - 8, 16, UINT64_MAX - 8, 1));
+  assert(!Contains(100, 64, 99, 1));
+  assert(Contains(100, 64, 163, 1));
+  assert(!Contains(100, 64, 163, 2));
+  for (uint32_t width : {656U, 2624U}) {
+    for (uint32_t workers : {1U, 2U, 3U, 8U, 64U}) TestGet(width, workers);
+  }
+  TestPut(335885, 1);
+  for (uint32_t workers : {1U, 2U, 8U, 32U}) TestPut(335904, workers);
+  std::cout << "UBmem actual-kernel CPU model PASS (bytes, tails, guards, sector ownership, invalid prefixes, event credits)\n";
+}
diff --git a/access_operator/ubmem/tests/host_contract_test.cc b/access_operator/ubmem/tests/host_contract_test.cc
new file mode 100644
index 0000000..7578c6e
--- /dev/null
+++ b/access_operator/ubmem/tests/host_contract_test.cc
@@ -0,0 +1,218 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+#include <cassert>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <functional>
+#include <future>
+#include <chrono>
+#include <vector>
+
+#include "../host/kernel_loader.h"
+#include "meta_manager.h"
+#include "ubmem/local_access_operator.h"
+#include "ubmem/transfer_abi.h"
+
+namespace model {
+std::map<void*, bool> allocations;
+int32_t device = 0;
+bool fail_sync = false, fail_free = false, fail_d2h = false, fail_host_alloc = false;
+bool bad_status = false;
+std::function<void()> sync_hook;
+uint32_t sync_calls = 0, async_d2h = 0, blocking_d2h = 0;
+struct PendingCopy { void* destination; const void* source; size_t bytes; aclrtStream stream; };
+std::vector<PendingCopy> pending;
+uint32_t frees = 0, copies = 0, memsets = 0, launches = 0;
+void* stream = reinterpret_cast<void*>(1);
+uint64_t Address(const void* pointer) { return reinterpret_cast<uintptr_t>(pointer); }
+}  // namespace model
+
+aclError aclrtGetDevice(int32_t* device) { *device = model::device; return 0; }
+aclError aclrtMalloc(void** address, size_t bytes, aclrtMemMallocPolicy) {
+  *address = std::malloc(bytes); assert(*address); model::allocations[*address] = false; return 0;
+}
+aclError aclrtMallocHost(void** address, size_t bytes) {
+  if (model::fail_host_alloc) { model::fail_host_alloc = false; return 20; }
+  *address = std::malloc(bytes); assert(*address); model::allocations[*address] = true; return 0;
+}
+aclError Release(void* address, bool host) {
+  if (model::fail_free) { model::fail_free = false; return 19; }
+  auto found = model::allocations.find(address);
+  assert(found != model::allocations.end() && found->second == host);
+  model::allocations.erase(found); std::free(address); ++model::frees; return 0;
+}
+aclError aclrtFree(void* address) { return Release(address, false); }
+aclError aclrtFreeHost(void* address) { return Release(address, true); }
+aclError aclrtMemcpy(void* destination, size_t capacity, const void* source, size_t bytes, aclrtMemcpyKind kind) {
+  if (kind == ACL_MEMCPY_DEVICE_TO_HOST) ++model::blocking_d2h;
+  assert(bytes <= capacity); ++model::copies; std::memcpy(destination, source, bytes); return 0;
+}
+aclError aclrtMemcpyAsync(void* destination, size_t capacity, const void* source, size_t bytes,
+                          aclrtMemcpyKind kind, aclrtStream stream) {
+  if (kind == ACL_MEMCPY_DEVICE_TO_HOST) {
+    if (model::fail_d2h) { model::fail_d2h = false; return 21; }
+    assert(bytes <= capacity && model::allocations.at(destination));
+    assert(stream == model::stream);
+    ++model::async_d2h;
+    // Do not make status visible before the production stream fence.
+    std::memset(destination, 0, capacity);
+    model::pending.push_back({destination, source, bytes, stream});
+    return 0;
+  }
+  return aclrtMemcpy(destination, capacity, source, bytes, kind);
+}
+aclError aclrtMemsetAsync(void* destination, size_t capacity, int value, size_t bytes, aclrtStream) {
+  assert(bytes <= capacity); ++model::memsets; std::memset(destination, value, bytes); return 0;
+}
+aclError aclrtSynchronizeStream(aclrtStream stream) {
+  ++model::sync_calls;
+  if (model::sync_hook) model::sync_hook();
+  if (model::fail_sync) return 17;
+  for (const auto& copy : model::pending) {
+    assert(copy.stream == stream);
+    std::memcpy(copy.destination, copy.source, copy.bytes);
+  }
+  model::pending.clear();
+  return 0;
+}
+aclError aclrtSynchronizeDevice() { return aclrtSynchronizeStream(model::stream); }
+
+namespace kvaf::ubmem {
+// The actual kernels are tested separately by copy_model_test.cc. This
+// launch double exercises the production host's ownership/error transitions.
+Status Kernel::Load(const std::string&, const char* name) {
+  function_ = reinterpret_cast<void*>(std::strstr(name, "Put") ? 2 : 1);
+  binary_ = function_;
+  return Status::OK();
+}
+Status Kernel::Unload() { binary_ = nullptr; function_ = nullptr; return Status::OK(); }
+aclError Kernel::Launch(const void* arguments, size_t, uint32_t workers, aclrtStream) const {
+  using namespace kvaf_ubmem;
+  ++model::launches;
+  if (function_ == reinterpret_cast<void*>(2)) {
+    const auto& args = *static_cast<const PutArgs*>(arguments);
+    const auto* entries = reinterpret_cast<const PutEntry*>(args.entries);
+    for (uint32_t i = 0; i < args.count; ++i) {
+      std::memcpy(reinterpret_cast<void*>(entries[i].destination),
+          reinterpret_cast<void*>(args.input + entries[i].input_offset), entries[i].length);
+    }
+    for (uint32_t i = 0; i < workers; ++i)
+      reinterpret_cast<CoreStatus*>(args.status)[i] = {kStatusMagic, kSuccess, UINT64_MAX, 0};
+    if (model::bad_status) reinterpret_cast<CoreStatus*>(args.status)[workers - 1].result = kInvalidSource;
+    for (uint32_t i = 0; i < args.count; ++i)
+      ++reinterpret_cast<CoreStatus*>(args.status)[
+          ((entries[i].destination - args.region_base) / args.slot_bytes) % workers].copied_requests;
+  } else {
+    const auto& args = *static_cast<const GetArgs*>(arguments);
+    if (args.status) {
+      for (uint32_t i = 0; i < workers; ++i) {
+        reinterpret_cast<CoreStatus*>(args.status)[i] = {kStatusMagic,
+            *reinterpret_cast<const int32_t*>(args.miss_count) < 0 ? kInvalidCount : kSuccess, UINT64_MAX, 0};
+      }
+    }
+  }
+  return 0;
+}
+}  // namespace kvaf::ubmem
+
+int main() {
+  using namespace kvaf;
+  using model::Address;
+  alignas(32) uint8_t arena[4096]{}, input[2048]{}, output[2624]{};
+  for (size_t i = 0; i < sizeof(input); ++i) input[i] = i % 251;
+  AccessOperatorConfig config;
+  config.batch_get_kernel_object_path = "get.o";
+  config.batch_put_kernel_object_path = "put.o";
+  config.npu_core_count = 2;
+  const RemoteRegionDesc region{Address(arena), sizeof(arena), 2048, DeviceKind::kCpu};
+  BatchPutRequest request{{0}, {input, sizeof(input), DeviceKind::kNpu}, {37}, {656}};
+  PutAccessDesc desc{{{0, Address(arena), 656}}};
+  BatchPutExecRequest put{&request, &desc, {model::stream}};
+  {
+    auto op = CreateUbmemAccessOperator(config);
+    assert(op->Initialize(region).ok());
+    const auto before_sync = model::sync_calls;
+    assert(op->ExecuteBatchPut(put).ok());
+    assert(model::sync_calls == before_sync + 1 && model::async_d2h == 1);
+    assert(model::blocking_d2h == 0 && model::pending.empty());
+    const auto allocations = model::allocations;
+    assert(op->ExecuteBatchPut(put).ok());
+    assert(model::allocations == allocations);  // status/metadata buffers reused
+    model::bad_status = true;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kInternal);
+    model::bad_status = false;
+    model::fail_d2h = true;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kInternal);
+    assert(op->ExecuteBatchPut(put).ok());  // completed copy error is retryable
+    assert(std::memcmp(arena, input + 37, 656) == 0);
+    assert(model::allocations.size() == 4);
+    int32_t index = 0, offset = 0, count = -1, out_index = 0;
+    uint64_t table = Address(arena);
+    uint8_t valid = 1;
+    BatchGetRequest get;
+    get.indices = {&index, 4, DeviceKind::kNpu};
+    get.offsets = {&offset, 4, DeviceKind::kNpu};
+    get.miss_count = {&count, 4, DeviceKind::kNpu};
+    get.output_indices = {&out_index, 4, DeviceKind::kNpu};
+    get.output = {output, 656, DeviceKind::kNpu};
+    get.output_block_bytes = 656;
+    get.tokens_per_block = 1;
+    get.device_access_table = {{&table, 8, DeviceKind::kNpu}, {&valid, 1, DeviceKind::kNpu}};
+    assert(op->ExecuteBatchGet({{}, &get, {model::stream, true}}).code() == StatusCode::kInternal);
+    count = 0;
+    auto before_copies = model::copies, before_memsets = model::memsets;
+    assert(op->ExecuteBatchGet({{}, &get, {model::stream, false}}).ok());
+    assert(model::copies == before_copies && model::memsets == before_memsets);
+    // A Put waiting on its stream must not block normal async Get submission.
+    model::sync_hook = [&] {
+      auto submitted = std::async(std::launch::async, [&] {
+        return op->ExecuteBatchGet({{}, &get, {model::stream, false}});
+      });
+      assert(submitted.wait_for(std::chrono::seconds(2)) == std::future_status::ready);
+      assert(submitted.get().ok());
+    };
+    assert(op->ExecuteBatchPut(put).ok());
+    model::sync_hook = {};
+    model::device = 1;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kInvalidState);
+    model::device = 0;
+    request.keys.push_back(1); request.input_offsets.push_back(800); request.lengths.push_back(1);
+    desc.entries.push_back({1, Address(arena + 2048), 1});
+    model::fail_free = true;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kInternal);
+    assert(model::allocations.size() == 4);  // failed release was retained
+    assert(op->Shutdown().ok());
+    assert(op->Shutdown().ok());
+    assert(model::allocations.empty());
+  }
+  {
+    auto op = CreateUbmemAccessOperator(config);
+    assert(op->Initialize(region).ok());
+    model::fail_host_alloc = true;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kInternal);
+    assert(model::allocations.size() == 1 && model::pending.empty());
+    assert(op->Shutdown().ok());
+    assert(model::allocations.empty());
+  }
+  {
+    auto op = CreateUbmemAccessOperator(config);
+    assert(op->Initialize(region).ok());
+    model::fail_sync = true;
+    auto before_frees = model::frees;
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kCompletionUnknown);
+    assert(model::allocations.size() == 4);  // device/pinned status + device/pinned metadata
+    assert(op->ExecuteBatchPut(put).code() == StatusCode::kCompletionUnknown);
+    assert(op->Shutdown().code() == StatusCode::kCompletionUnknown);
+    op.reset();
+    assert(model::frees == before_frees && model::allocations.size() == 4);
+    // Intentional leaked owner models process-teardown quarantine. Fake NPU
+    // allocations can be reclaimed here; no code retains a runnable operator.
+    for (auto allocation : model::allocations) std::free(allocation.first);
+    model::allocations.clear();
+    model::pending.clear();
+  }
+  std::cout << "UBmem host contract PASS (one Put fence, pinned readback, async Get, copy failure, completion quarantine)\n";
+}
